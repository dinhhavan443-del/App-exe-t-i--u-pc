<Window x:Class="PEDINHIOS.FPSBoost.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PEDINHIOS FPS BOOST PRO" Height="720" Width="1080" MinHeight="650" MinWidth="950" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="#EAF8FF">
<Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#0D1722" BorderBrush="#1B4258" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16"><DockPanel>
<StackPanel><TextBlock Text="PEDINHIOS" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="FPS BOOST PRO" FontSize="30" FontWeight="ExtraBold"/><TextBlock Text="BLUESTACKS PERFORMANCE CONTROL" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
<StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="WINDOWS DESKTOP EDITION" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock x:Name="BlueStacksStatus" Text="Đang kiểm tra BlueStacks..." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
</DockPanel></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Margin="0,0,12,0">
<UniformGrid Columns="2" Margin="0,0,0,12">
<Border Background="{StaticResource Panel}" CornerRadius="14" Padding="18" Margin="0,0,6,0"><StackPanel><TextBlock Text="CPU TOÀN HỆ THỐNG" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CpuValue" Text="--%" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,8,0,0"/></StackPanel></Border>
<Border Background="{StaticResource Panel}" CornerRadius="14" Padding="18" Margin="6,0,0,0"><StackPanel><TextBlock Text="RAM ĐANG DÙNG" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RamValue" Text="-- / -- GB" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,8,0,0"/></StackPanel></Border>
</UniformGrid>
<Border Background="{StaticResource Panel}" CornerRadius="14" Padding="18" Margin="0,0,0,12"><StackPanel>
<TextBlock Text="BLUESTACKS PROCESS" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="ProcessInfo" Text="Chưa phát hiện HD-Player.exe" Foreground="{StaticResource Muted}" Margin="0,8,0,12" TextWrapping="Wrap"/>
<WrapPanel><Button Content="QUÉT LẠI" Click="Refresh_Click"/><Button Content="BOOST PROCESS" Background="#07516B" BorderBrush="#55D8FF" Click="Boost_Click"/><Button Content="RESTORE PRIORITY" Click="Restore_Click"/></WrapPanel>
<TextBlock x:Name="ActionStatus" Text="Sẵn sàng." Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="4,12,4,0"/>
</StackPanel></Border>
<Border Background="{StaticResource Panel}" CornerRadius="14" Padding="18"><StackPanel>
<TextBlock Text="FPS TARGET / PERFORMANCE" FontSize="16" FontWeight="Bold"/>
<TextBlock Text="Mục tiêu FPS là hướng dẫn cấu hình, không thể mở khóa FPS mà game hoặc phần cứng không hỗ trợ." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
<WrapPanel><TextBlock Text="Mục tiêu:" VerticalAlignment="Center" Margin="4"/><ComboBox x:Name="FpsCombo" Width="130" SelectedIndex="0" Padding="8" Background="#172A39" Foreground="#EAF8FF"><ComboBoxItem Content="60 FPS"/><ComboBoxItem Content="90 FPS"/><ComboBoxItem Content="120 FPS"/><ComboBoxItem Content="144 FPS"/></ComboBox><Button Content="HƯỚNG DẪN" Click="Guide_Click"/></WrapPanel>
<TextBlock Text="Trong BlueStacks: Settings → Performance để chỉnh CPU, RAM và High frame rate. Lưu thay đổi, khởi động lại nếu được yêu cầu." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,12,4,0"/>
</StackPanel></Border></StackPanel>
<StackPanel Grid.Column="1">
<Border Background="{StaticResource Panel}" CornerRadius="14" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="SYSTEM PROFILE" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="CpuName" Text="CPU: Đang đọc..." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,6"/><TextBlock x:Name="RamTotal" Text="RAM: Đang đọc..." Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><TextBlock x:Name="OsInfo" Text="Windows: Đang đọc..." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Background="{StaticResource Panel}" CornerRadius="14" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="SAFE OPTIMIZATION" FontSize="16" FontWeight="Bold"/><TextBlock Text="• Đặt HD-Player.exe thành AboveNormal khi nhấn BOOST&#10;• Không dùng Realtime priority&#10;• Không tắt Defender hay dịch vụ hệ thống&#10;• Không sửa dữ liệu game / file nội bộ BlueStacks" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="23"/></StackPanel></Border>
<Border Background="#10202B" BorderBrush="#24536A" BorderThickness="1" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="PEDINHIOS • PERFORMANCE TOOLS" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="Ưu tiên tiến trình có thể giúp phản hồi ổn định hơn trong một số tình huống, nhưng không đảm bảo tăng FPS. Nhiệt độ, driver và cấu hình máy vẫn quyết định hiệu năng." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
</StackPanel></Grid>
<TextBlock Grid.Row="2" Text="PEDINHIOS FPS BOOST PRO  •  WINDOWS APP  •  v1.0.0" Foreground="#587184" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="10"/>
</Grid></Window>